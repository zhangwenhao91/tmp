+/// Return the hardware pipe an operation executes on, or PIPE_UNASSIGNED
+/// when the operation has no single-pipe assignment or its pipe cannot host
+/// INTRA.BLOCKI synchronization.
+static PIPE getOperationExecPipe(Operation *op) {
+  auto pipeIf = dyn_cast<NpuOpPipeInterface>(op);
+  if (!pipeIf || !pipeIf.isSinglePipeOp()) {
+    return PIPE::PIPE_UNASSIGNED;
+  }
+  PIPE pipe = pipeIf.getPipe();
+  switch (pipe) {
+  case PIPE::PIPE_MTE1:
+  case PIPE::PIPE_MTE2:
+  case PIPE::PIPE_MTE3:
+  case PIPE::PIPE_V:
+  case PIPE::PIPE_FIX:
+    return pipe;
+  default:
+    return PIPE::PIPE_UNASSIGNED;
+  }
+}
